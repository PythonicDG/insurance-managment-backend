# Replace paths/user; configure the production environment before enabling.
[Unit]
Description=InsureLedger api
After=network.target

[Service]
Type=simple
User=insureledger
Group=insureledger
WorkingDirectory=/srv/insureledger/backend
ExecStart=/srv/insureledger/backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 60 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

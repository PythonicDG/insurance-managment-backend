# Replace paths/user; configure the production environment before enabling.
[Unit]
Description=InsureLedger renewals
After=network.target

[Service]
Type=simple
User=insureledger
Group=insureledger
WorkingDirectory=/srv/insureledger/backend
ExecStart=/srv/insureledger/backend/.venv/bin/python manage.py process_renewal_reminders --watch
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

# Production template. Supply actual domains and secrets; never commit the resulting .env.
# Never commit .env. See docs/INSTALLATION.md and docs/CONFIGURATION.md.
SECRET_KEY=replace-with-generated-secret
DEBUG=False
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://app.example.com
DB_ENGINE=postgresql
DB_NAME=insurance_db
DB_USER=insurance_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
TIME_ZONE=Asia/Kolkata
AUDIT_TRUSTED_PROXY_IPS=
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Set SMTP credentials or deliberately retain console email until SMTP is verified.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=notifications@example.com
EMAIL_TIMEOUT=15
ADMIN_NOTIFICATION_EMAIL=
# Most WhatsApp values initialize database-backed settings, not live overrides.
WHATSAPP_ENABLED=False
WHATSAPP_TEST_MODE=True
WHATSAPP_TEST_PHONE=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_POLICY_CREATED=insurance_policy_issued
WHATSAPP_TEMPLATE_PAYMENT_COLLECTED=payment_receipt_collected

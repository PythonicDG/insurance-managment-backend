# Local development defaults. scripts/configure_local.py creates .env and generates SECRET_KEY.
# Never commit .env. See docs/INSTALLATION.md and docs/CONFIGURATION.md.
SECRET_KEY=replace-with-generated-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DB_ENGINE=sqlite
DB_NAME=insurance_db
DB_USER=insurance_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
TIME_ZONE=Asia/Kolkata
AUDIT_TRUSTED_PROXY_IPS=
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Console email avoids sending real messages during local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=notifications@example.com
EMAIL_TIMEOUT=15
ADMIN_NOTIFICATION_EMAIL=
# Optional WhatsApp integration is disabled. Empty credentials are not needed for local startup.
# These values initialize saved database settings; edit existing settings through the application.
WHATSAPP_ENABLED=False
WHATSAPP_TEST_MODE=True
WHATSAPP_TEST_PHONE=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_POLICY_CREATED=insurance_policy_issued
WHATSAPP_TEMPLATE_PAYMENT_COLLECTED=payment_receipt_collected
